{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!!**/node_modules", "!!**/dist", "!!**/public"]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "attributePosition": "auto"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "single",
      "semicolons": "asNeeded",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "trailingCommas": "all",
      "quoteProperties": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "complexity": {
        "noBannedTypes": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      }
    }
  },
  "assist": {
    "enabled": true
  },
  "overrides": [
    {
      "includes": ["client/**/*.js", "client/**/*.jsx"],
      "javascript": {
        "globals": ["window", "document", "navigator", "fetch", "location", "localStorage", "sessionStorage"]
      }
    },
    {
      "includes": ["server/**/*.js", "test/**/*.js"],
      "javascript": {
        "globals": ["process", "require", "module", "console", "__dirname", "__filename"]
      }
    }
  ]
}
